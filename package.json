{
  "name": "dsh-az8",
  "version": "0.2.0",
  "private": false,
  "description": "AZ8 Studio generation plugin for DeepSeek Harness: chat-driven image/video generation via the az8 CLI with quote gate, run journal, asset panel and skill packs. / 让 DSH Agent 通过 az8 CLI 在对话内生成图片/视频：报价闸门、运行日志、资产面板与技能包。",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "az8",
    "image-generation",
    "video-generation"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cli.js",
    "store.js",
    "skills.js",
    "orchestrator.js",
    "panel.js",
    "tools.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.md",
    "test/*.mjs",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node test/store.test.mjs && node test/orchestrator.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}